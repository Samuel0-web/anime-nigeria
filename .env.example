APP_NAME="your_app_name"
APP_ENV=local
APP_DEBUG=true
APP_URL=yourdomain.com

DB_HOST=private_ip_or_hostname
DB_PORT=preferred_port
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=your_database_password

SESSION_NAME=your_session_name
REMEMBER_ME_COOKIE=your_remember_cookie
DEVICE_IDENTIFIER_COOKIE=your_device_cookie

SESSION_COOKIE_LIFETIME=0
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

APP_TIMEZONE=UTC
SSE_ENABLED=1

MAIL_HOST=your_host
MAIL_PORT=your_port
MAIL_USERNAME=yourapp@example.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls

MAIL_FROM_NAME="your_site_name"
MAIL_FROM_ADDRESS=yourapp@example.com

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_google_redirect_uri