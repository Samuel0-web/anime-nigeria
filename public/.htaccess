Options -Indexes

RewriteEngine On

# API and stream endpoints must always pass through router.php.
RewriteRule ^(?:.*/)?(?:api|stream)(?:/|$) router.php [QSA,L]

# If the requested file or folder exists, serve it normally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise send everything to router.php
RewriteRule ^ router.php [QSA,L]